{
  "name": "api-express",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker start mongo-tarefas || docker run -d --name mongo-tarefas -p 127.0.0.1:27017:27017 -v mongo-tarefas-data:/data/db mongo:8",
    "db:down": "docker stop mongo-tarefas",
    "db:logs": "docker logs -f mongo-tarefas",
    "db:reset": "docker rm -f mongo-tarefas; docker volume rm mongo-tarefas-data",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "mongodb": "^7.7.0"
  }
}
